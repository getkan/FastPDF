# FastPDF — environment variables
# Copy to .env and fill in real values before starting the service.
# AUTH_PASSWORD and JWT_SECRET MUST be set; all others have safe defaults.

NODE_ENV=development
PORT=2626
HOST=0.0.0.0
LOG_LEVEL=info

AUTH_PASSWORD=change-me-use-at-least-16-chars
JWT_SECRET=change-me-use-at-least-32-characters-here
JWT_EXPIRES_IN=1d

MAX_HTML_SIZE=5242880
CONCURRENT_RENDERS=5
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false

SENTRY_DSN=
